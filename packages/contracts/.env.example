# smorx-contracts configuration.
#
# This package has no required environment variables: it is a pure contract
# library (versioned JSON Schemas + pydantic v2 models + registry). It does
# not read credentials or configuration at import time.
#
# The variables below are reserved for future optional runtime behavior and
# are intentionally unset.
#
# SMORX_CONTRACTS_SCHEMA_DIR=
# SMORX_CONTRACTS_STRICT_REFERENCE_CHECK=1