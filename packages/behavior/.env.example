# smorx-behavior — environment reference
# Values shown are defaults; never commit real credentials.

# Default when unset: file-backed SQLite via aiosqlite.
DATABASE_URL=sqlite+aiosqlite:///./smorx.db

# Supabase PostgreSQL target (project ref tyhwdqraeioxzmkrofib, ap-southeast-2).
# The 31-table behavioral schema is already migrated in that project.
# For async engines keep the asyncpg driver:
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# For sync engines (Alembic migrations) use the psycopg driver:
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase API surface (used by frontend/web and client tooling, not by the
# SQLAlchemy layer). Replace with real values obtained from the dashboard:
# SUPABASE_URL=https://tyhwdqraeioxzmkrofib.supabase.co
# SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Optional pool hints (ignored for SQLite; applied to pool-capable backends).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Alembic bootstrap helper (development/evaluation only).
# SMORX_BOOTSTRAP=create
# SMORX_BOOTSTRAP=drop