# =============================================================================
# Software Evolution Intelligence System - Phase 1 Infrastructure Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Nebius Token Factory inference (OpenAI-compatible API) ---
# Create an API key at https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=
# Public endpoint base URL (either the global public endpoint or a regional one)
NEBIUS_INFERENCE_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Nebius Token Factory Sandboxes (ConTree) ---
# Project id used to scope sandbox namespaces.
NEBIUS_AI_PROJECT=
# Alternative alias accepted by the application (used if NEBIUS_AI_PROJECT is empty)
NEBIUS_PROJECT_ID=
# ConTree instance base URL
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes

# --- NVIDIA Nemotron model routing (configurable model IDs) ---
# Lightweight tier: routine extraction / classification / lightweight reasoning
NEMOTRON_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Normal tier: coding, debugging, multi-file reasoning
NEMOTRON_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# Hard tier: difficult root-cause / architecture / final synthesis
NEMOTRON_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Timeouts and retries ---
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_FACTOR=1.5
SANDBOX_TIMEOUT_SECONDS=300
COMMAND_TIMEOUT_SECONDS=120
SANDBOX_POLL_SECS=2.0
OUTPUT_TRUNCATE_AT=65535

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Health check gate (set to "1" to run integration health at startup) ---
INFRA_CHECK_ON_STARTUP=0